# .redline.yml — external tools Redline runs as part of the lint-delta pane.
#
# The three built-in tools (golangci-lint, eslint, gorefactor) need no config
# here; they are detected by their own config file. This file is for anything
# else: an OpenAPI linter, a TypeScript type-checker, a breaking-change diff.
# Each tool is run at the base revision and at head and only what the change
# introduces is reported, the same way the built-in tools work.
#
# Copy this to .redline.yml and delete the tools you do not use.

tools:
  # vacuum — OpenAPI linter, Spectral-compatible JSON via `spectral-report`.
  # `spectral-report <spec> <out>` writes to a file, so point it at /dev/stdout.
  - name: vacuum
    command: vacuum
    args: ["spectral-report", "openapi.yaml", "/dev/stdout"]
    scope: ["openapi.yaml", "**/*.openapi.yaml"]
    format: spectral
    # Spectral (and vacuum) number lines from 0; Redline numbers from 1.
    lineOffset: 1
    # Spectral severities are numbers: 0 error, 1 warn, 2 info, 3 hint. The
    # defaults already map 0 and 1; spell the rest out if you want them louder.
    severityMap:
      "2": info
      "3": info

  # eslint via a type-aware run you drive yourself. (Plain eslint is already
  # built in and detected by .eslintrc; this shows an arbitrary command.)
  - name: tsc
    command: npx
    args: ["tsc", "--noEmit", "--pretty", "false"]
    scope: ["**/*.ts", "**/*.tsx"]
    # tsc does not emit JSON; wrap it in a script that does, or use a reporter.
    # This entry is illustrative — see `format: json` below for the mapping.
    format: json
    resultsPath: results
    fields:
      file: file
      line: line
      rule: code
      message: message
      severity: severity

  # oasdiff — a differ: it compares two spec files itself rather than linting
  # one snapshot, so kind is "differ" and the two spec paths are substituted
  # into the args. {{base}} is the spec at the merge base, {{head}} at head.
  - name: oasdiff
    kind: differ
    command: oasdiff
    args: ["breaking", "--format", "json", "{{base}}", "{{head}}"]
    scope: ["openapi.yaml"]
    format: json
    resultsPath: ""      # oasdiff's JSON is a bare array
    fields:
      file: source
      rule: id
      message: text
      severity: level
    severityMap:
      ERR: error
      WARN: warning
      INFO: info

  # A tool with its own committed baseline file (accepted debt), read instead
  # of a second run. Report only what exceeds the baseline.
  - name: mylinter
    command: mylinter
    args: ["--json", "."]
    scope: ["**/*.go"]
    format: json
    resultsPath: issues
    fields: {file: file, line: line, rule: rule, message: message, severity: severity}
    baseline:
      mode: file
      file: .mylinter-baseline.json

# Fields reference
#
#   name         identifier; shows up as "<name>/<rule>" on each finding
#   kind         "linter" (default) run per revision and diff, or "differ"
#                run once comparing {{base}} and {{head}} directly
#   command/args the executable and its arguments
#   okExitCodes  exit codes that mean "ran" (default [0, 1]); others = failure
#   scope        glob patterns this tool covers ("**" crosses directories)
#   format       "sarif", "spectral", or "json"
#   resultsPath  (json) dotted path to the results array; "" if the root is it
#   itemsPath    (json) dotted path to a nested results array inside each
#                resultsPath element; fans out one finding per inner item,
#                fields resolved against the inner item then the outer group
#   fields       (json) dotted paths to each result's file/line/rule/message/severity
#   severityMap  the tool's severity spelling -> error | warning | info
#   lineOffset   added to every line number (set 1 for 0-indexed tools)
#   baseline     mode "revision" (default) or "file" + the baseline file path
#
# harness — artifacts listed in profiles are required when scope matches.
# `redline run --prepare` runs produce when a profile declares it.
#
# harness:
#   env:
#     from: scripts/redline-env.sh   # optional: sourced before each produce
#   profiles:
#     - id: go
#       path: coverage.out
#       produce:
#         command: make
#         args: [test-coverage]
#       when: stale                  # missing | stale | always (default stale)
#       scope: ["**/*.go"]
#     - id: mutation                 # require-only: no produce (--prepare skips)
#       path: mutants.json
#       when: stale
#       scope: ["**/*.go"]
#
# harness.worktree — steps in the tree under review before linters run (PR
# worktrees included), for example make stub-ui when go:embed needs ui/dist:
#
#   worktree:
#     - id: ui-embed
#       path: ui/dist/index.html
#       produce: {command: make, args: [stub-ui]}
#       when: missing
#

# context — the language providers that resolve a change beyond the diff, for
# `redline review`. Redline links no language toolchain: a provider is a
# separate program, run as a subprocess, that prints a context envelope as
# JSON. See docs/context-envelope.md for the format.
#
# A repository with .gorefactor.yaml gets the Go provider with no entry here.
# Declare one to override that invocation, or to add another language.
#
# context:
#   - name: gorefactor
#     command: gorefactor
#     args: ["context", "--changed", "{{base}}", "--json"]
#     scope: ["**/*.go"]
#   - name: tsctx
#     command: tsctx
#     args: ["--base", "{{base}}", "--json"]
#     scope: ["**/*.ts", "**/*.tsx"]
#
# graphify — a provider backed by a Graphify graph
# (github.com/Graphify-Labs/graphify), which parses the whole repository with
# tree-sitter into graphify-out/graph.json. It reaches the SQL, Terraform and
# shell files no single language toolchain sees, which is why its scope is
# everything: a changed file outside every provider's scope is reported as
# unexamined, and today that is every file that is not Go.
#
# Its edges match by name, not by type, so --defer-callers hands the caller
# question back to whichever provider resolves it exactly. Point it at that
# provider's scope. Everything else the graph knows still comes through.
#
# Pair it with the harness profile below. graph.json is a build artifact, and
# an adapter reading a stale one writes a different envelope for the same
# commit.
#
# context:
#   - name: graphify
#     command: redline-graphify-context
#     args: ["--graph", "graphify-out/graph.json", "--changed", "{{base}}",
#            "--defer-callers", "**/*.go"]
#     scope: ["**/*"]
#
# scout — the provider that costs money. A cheap model reads the diff, works
# out what this change needs, finds it with the tools this checkout has
# (gorefactor, the graph, grep, git log), and records where it is; the program
# copies those bytes from the tree, so the reviewer gets real source under a
# selection a model made.
#
# Configuring it means `redline run` calls a model and needs ANTHROPIC_API_KEY.
# --max-cost is a governor, not a tripwire: when it binds the scout stops,
# says so in the report's unknowns, and the review still happens.
#
# context:
#   - name: scout
#     command: redline-scout
#     args: ["--changed", "{{base}}", "--max-cost", "0.25"]
#     scope: ["**/*"]
#
# harness:
#   profiles:
#     - id: graph
#       path: graphify-out/graph.json
#       produce:
#         command: graphify
#         args: [update, "."]
#       when: stale
#
#   name         identifier; shows up on the report and in error messages
#   command/args the executable and its arguments; "{{base}}" becomes the
#                merge-base SHA
#   scope        globs this provider speaks for; a changed file outside every
#                provider's scope is reported as uncovered by the context layer
#   okExitCodes  exit codes that mean the provider ran (default [0])
