# Copy to the consuming repo as .github/redline-review.yml and pass
#   redline post --pr N --profile .github/redline-review.yml
#
# Marketplace's /review-bot reads these marker names. Another repo can
# pick its own; Redline does not hard-code them.

review_marker: mct-agent-review:v1
finding_marker: mct-agent-finding:v1

# error and warning fail the gate. info is visible on the review but does
# not stamp a finding marker, so it does not open a blocking thread.
blocking:
  - error
  - warning

author_only: true
require_head: true
# A pane that applied to the change but did not run is fail, even with no
# findings. A missing check must not read as pass.
fail_closed_pane: true

# Body layout on the posted review. "evidence" (default) is the one-line-per-
# pane body. "walkthrough" reads like the author-published Copilot/Bugbot
# reviews: reviewed-by and commit, the PR's stated intent, what the change
# does, a collapsible walkthrough of every changed file, then evidence folded
# away and the findings.
body_style: evidence

# Walkthrough add-ons, all opt-in, so you decide how much of the report reaches
# the pull request. coverage, lint, confirmations and unknowns are ignored in
# evidence mode; low-confidence applies in both.
#   coverage       per-file uncovered-added-lines column
#   lint           per-file finding counts by severity
#   confirmations  the checks that ran clean, folded in collapsed
#   unknowns       what could not be determined, folded in collapsed
#   low-confidence the reviewer's unsure findings, folded behind a chevron
#                  instead of withheld from the pull request
# body_include:
#   - coverage
#   - lint
#   - confirmations
#   - unknowns
#   - low-confidence
