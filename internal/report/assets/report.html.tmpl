<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Redline — {{.Subtitle}}</title>
<style>
:root{
  --bg:#fbfbfa; --panel:#fff; --ink:#1a1a19; --muted:#6b6b68; --line:#e4e4e1;
  --error:#b4241f; --warn:#a1660a; --info:#3a6ea5; --ok:#2f6b45;
  --add-bg:#e9f5ec; --del-bg:#fdeceb; --accent:#6b4ea1; --code:#f6f6f4;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#161615; --panel:#1e1e1d; --ink:#e8e8e5; --muted:#9a9a95; --line:#333331;
  --error:#f08a84; --warn:#e0b060; --info:#87b3e0; --ok:#7cc79a;
  --add-bg:#1b2f22; --del-bg:#33201f; --accent:#b79ce8; --code:#232322;
}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font:15px/1.55 ui-sans-serif,-apple-system,"Segoe UI",system-ui,sans-serif;}
/* Sidebar and content. The report is long by design — it is a map of a change,
   not a summary — so it needs a map of itself. */
.shell{display:grid;grid-template-columns:216px minmax(0,1fr);gap:36px;
  max-width:1320px;margin:0 auto;align-items:start}
.wrap{min-width:0;padding:32px 24px 96px}
.nav{position:sticky;top:0;max-height:100vh;overflow-y:auto;
  padding:36px 0 32px 24px;font-size:13px}
.nav h2{margin:0 0 10px;font-size:11px}
.nav ol{list-style:none;margin:0;padding:0}
.nav li{margin:0}
.nav a{display:flex;gap:8px;align-items:baseline;justify-content:space-between;
  padding:6px 10px 6px 12px;border-left:2px solid transparent;color:var(--muted);
  text-decoration:none;line-height:1.35}
.nav a:hover{color:var(--ink);background:var(--code)}
.nav a.on{color:var(--ink);border-left-color:var(--accent);font-weight:600}
.nav .c{font-variant-numeric:tabular-nums;color:var(--muted);font-weight:400;font-size:12px}
/* A section that is a gap rather than a result: no captures of a UI that moved,
   no coverage profile, something undetermined. Visible without scrolling. */
.nav a.gap .c{color:var(--warn)}
.nav a.gap::after{content:"";width:5px;height:5px;border-radius:50%;
  background:var(--warn);flex:none;align-self:center}
@media (max-width:900px){
  .shell{grid-template-columns:1fr;gap:0}
  .nav{position:sticky;top:0;z-index:30;max-height:none;padding:8px 16px;
    background:var(--bg);border-bottom:1px solid var(--line);overflow-x:auto}
  .nav h2{display:none}
  .nav ol{display:flex;gap:4px;white-space:nowrap}
  .nav a{border-left:0;border-bottom:2px solid transparent;padding:6px 10px}
  .nav a.on{border-bottom-color:var(--accent)}
}
@media print{.nav{display:none}}
h1{font-size:24px;margin:0;letter-spacing:-.01em}
h2{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);
  margin:40px 0 12px;font-weight:600}
h3{font-size:16px;margin:0 0 4px}
a{color:inherit}
.sub{color:var(--muted);margin:4px 0 0}
.banner{background:var(--del-bg);border-left:3px solid var(--error);padding:14px 16px;
  margin:20px 0;border-radius:0 6px 6px 0}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin:16px 0}
.tile{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:12px 14px}
.tile .n{font-size:22px;font-weight:600;font-variant-numeric:tabular-nums}
.tile .l{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.n.error{color:var(--error)} .n.warning{color:var(--warn)} .n.ok{color:var(--ok)}
.hl{background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--info);
  border-radius:0 8px 8px 0;padding:12px 16px;margin:8px 0}
.hl.breaking{border-left-color:var(--error)}
.hl .t{font-weight:600}
.hl .d{color:var(--muted);font-size:14px;margin-top:2px}
table.comp{width:100%;border-collapse:collapse;margin:12px 0;font-size:13px}
table.comp th,table.comp td{text-align:left;padding:6px 10px;border-bottom:1px solid var(--line)}
table.comp td.plus{color:var(--ok);font-variant-numeric:tabular-nums}
table.comp td.minus{color:var(--error);font-variant-numeric:tabular-nums}
.f{background:var(--panel);border:1px solid var(--line);border-radius:10px;
  padding:16px 18px;margin:12px 0}
.f.error{border-left:3px solid var(--error)}
.f.warning{border-left:3px solid var(--warn)}
.f.info{border-left:3px solid var(--info)}
.f-actions{margin-top:12px;display:flex;gap:8px}
.f-actions button{font:inherit;font-size:12px;padding:4px 11px;border:1px solid var(--line);
  border-radius:6px;background:var(--bg);color:var(--ink);cursor:pointer}
.f-actions button:hover{background:var(--code)}
.tag{display:inline-block;font-size:11px;text-transform:uppercase;letter-spacing:.06em;
  padding:2px 7px;border-radius:4px;background:var(--code);color:var(--muted);
  font-weight:600;vertical-align:2px}
.tag.det{background:color-mix(in srgb,var(--ok) 15%,transparent);color:var(--ok)}
.tag.vd{background:color-mix(in srgb,var(--info) 18%,transparent);color:var(--info)}
.verdict{margin-top:8px;display:flex;gap:8px;align-items:baseline;font-size:13px}
.meta-row{color:var(--muted);font-size:13px;margin-top:8px}
.meta-row b{color:var(--ink);font-weight:600}
blockquote{margin:12px 0 0;padding:10px 14px;background:var(--code);border-radius:6px;
  font-size:14px;color:var(--muted)}
code,pre{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px}
pre.diff{background:var(--code);border:1px solid var(--line);border-radius:8px;
  padding:10px 12px;overflow-x:auto;margin:8px 0 0;line-height:1.3}
pre.diff span{display:block;white-space:pre}
.add{background:var(--add-bg)} .del{background:var(--del-bg)}
.hunk{color:var(--info)} .meta{color:var(--muted)}
details{background:var(--panel);border:1px solid var(--line);border-radius:10px;
  padding:0;margin:10px 0;overflow:hidden}
details>summary{cursor:pointer;padding:13px 18px;font-weight:600;list-style:none;
  display:flex;justify-content:space-between;gap:12px;align-items:center}
details>summary::-webkit-details-marker{display:none}
details>summary::after{content:"▸";color:var(--muted);font-weight:400}
details[open]>summary::after{content:"▾"}
details>summary:hover{background:var(--code)}
.body{padding:0 14px 12px;border-top:1px solid var(--line)}
.file{padding:10px 0;border-bottom:1px solid var(--line)}
.file:last-child{border-bottom:none}
.file .p{font-family:ui-monospace,monospace;font-size:13px;font-weight:600}
.file .s{font-size:12px;color:var(--muted)}
.walk{background:var(--panel);border:1px solid var(--line);border-radius:10px;margin:12px 0;overflow:hidden}
.walk-row{padding:12px 16px;border-bottom:1px solid var(--line)}
.walk-row:last-child{border-bottom:none}
/* The walk rows are buttons so a click opens the drawer. Without resetting the
   button chrome they lay out as inline-blocks at their intrinsic width, which
   turns the report's primary list into a two-column jumble of centred text. */
.walk-row.jump{display:block;width:100%;text-align:left;background:none;border:0;
  border-bottom:1px solid var(--line);font:inherit;color:inherit;cursor:pointer}
.walk-row.jump:last-child{border-bottom:none}
.walk-row.jump:hover{background:var(--code)}
.walk-row.jump:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.walk-head{display:flex;justify-content:space-between;gap:12px;align-items:baseline;flex-wrap:wrap}
.plus{color:var(--ok)} .minus{color:var(--error)}
ul.plain{margin:8px 0;padding-left:20px}
ul.plain li{margin:4px 0}
/* 002-B: the drawer. Drilling into a file is a choice, not a navigation —
   the briefing stays put behind it, so a reviewer can open six files in a row
   without losing the map or scrolling back up from the bottom of the page. */
.scrim{position:fixed;inset:0;background:rgba(0,0,0,.28);z-index:40}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(860px,92vw);z-index:41;
  background:var(--bg,#fff);border-left:1px solid var(--line);
  box-shadow:-8px 0 32px rgba(0,0,0,.12);overflow-y:auto;padding:0 18px 96px}
.drawer-head{position:sticky;top:0;background:inherit;padding:14px 0 10px;
  border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:center;justify-content:space-between}
.drawer .keep{font:inherit;font-size:13px;padding:6px 12px;border:1px solid var(--line);
  border-radius:6px;background:none;cursor:pointer}
.drawer .keep:hover{background:var(--hover,rgba(0,0,0,.04))}
body.drawer-open{overflow:hidden}
@media (max-width:640px){.drawer{width:100vw}}
.tile{font:inherit;color:inherit;text-align:left;cursor:pointer}
.tile:hover{background:var(--hover,rgba(0,0,0,.03))}
.tile:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.f[hidden]{display:none}
.filter-note{font-size:13px;color:var(--muted);margin:8px 0}
.filter-note button{font:inherit;font-size:13px;background:none;border:0;color:var(--accent);cursor:pointer;text-decoration:underline}
.empty{color:var(--muted);font-style:italic}
pre.diff span[data-line]{cursor:text;position:relative}
pre.diff span[data-line]::before{content:attr(data-line);display:inline-block;width:3em;
  margin-right:14px;text-align:right;color:var(--muted);user-select:none;opacity:.7}
pre.diff span[data-line]:hover{outline:1px solid var(--info);outline-offset:-1px}
pre.diff span.hit{background:rgba(250,204,21,.28)}
.viewed{opacity:.45}
.viewed .p{text-decoration:line-through}
label.vw{font-size:12px;color:var(--muted);display:flex;gap:6px;align-items:center;
  cursor:pointer;user-select:none;font-weight:400}
.cmt{background:color-mix(in srgb,var(--info) 8%,var(--panel));border:1px solid var(--info);
  border-radius:6px;padding:8px 10px;margin:6px 0;font-size:13px}
.cmt .w{font-size:11px;color:var(--muted);font-family:ui-monospace,monospace}
.cmt button{float:right;background:none;border:none;color:var(--muted);cursor:pointer;font-size:14px}
.bar{position:sticky;bottom:0;background:var(--panel);border-top:1px solid var(--line);
  margin:32px -24px -96px;padding:12px 24px;display:flex;gap:12px;align-items:center;
  justify-content:space-between;font-size:13px}
.bar button{font:inherit;font-weight:600;padding:7px 14px;border-radius:6px;
  border:1px solid var(--line);background:var(--bg);color:var(--ink);cursor:pointer}
.bar button:hover{background:var(--code)}
.bar .n{color:var(--muted)}
textarea.new{width:100%;font:inherit;font-size:13px;padding:8px;border-radius:6px;
  border:1px solid var(--line);background:var(--bg);color:var(--ink);resize:vertical}
</style>
</head>
<body data-review="{{.Identity}}" data-target="{{.Subtitle}}">
<div class="shell">

<nav class="nav" aria-label="Sections">
  <h2>On this page</h2>
  <ol>
  {{range .Nav}}
    <li><a href="#{{.ID}}" data-nav="{{.ID}}"{{if .Warn}} class="gap"{{end}}>
      <span>{{.Label}}</span>
      {{if .Warn}}<span class="c">{{if .Count}}{{.Count}}{{else}}!{{end}}</span>{{else if .Count}}<span class="c">{{.Count}}</span>{{end}}
    </a></li>
  {{end}}
  </ol>
</nav>

<div class="wrap">

<h1>Redline</h1>
<p class="sub">{{.Subtitle}}{{if .Author}} · {{.Author}}{{end}}{{if .Commits}} · {{.Commits}} commit{{if ne .Commits 1}}s{{end}}{{end}}{{if .URL}} · <a href="{{.URL}}">{{.URL}}</a>{{end}}</p>

{{if .Banner}}<div class="banner">{{.Banner}}</div>{{end}}
<div class="tiles">
  <button type="button" class="tile" data-goto="observed" data-only="error"><div class="n {{if index .Counts "error"}}error{{else}}ok{{end}}">{{with index .Counts "error"}}{{.}}{{else}}0{{end}}</div><div class="l">errors</div></button>
  <button type="button" class="tile" data-goto="observed" data-only="warning"><div class="n warning">{{with index .Counts "warning"}}{{.}}{{else}}0{{end}}</div><div class="l">warnings</div></button>
  <button type="button" class="tile" data-goto="observed" data-only="info"><div class="n">{{with index .Counts "info"}}{{.}}{{else}}0{{end}}</div><div class="l">info</div></button>
  <button type="button" class="tile" data-goto="drill"><div class="n">{{.Coverage.ExaminedFiles}}/{{.Coverage.ChangedFiles}}</div><div class="l">files examined</div></button>
  {{with .Coverage.Diff}}
  <button type="button" class="tile" data-goto="coverage"><div class="n{{if .Stale}} warning{{end}}">{{if lt .Percent 0.0}}—{{else}}{{printf "%.0f" .Percent}}%{{end}}</div><div class="l">diff covered</div></button>
  {{else}}
  <button type="button" class="tile" data-goto="coverage"><div class="n warning">?</div><div class="l">diff covered</div></button>
  {{end}}
  <button type="button" class="tile" data-goto="confirms"><div class="n">{{len .Confirms}}</div><div class="l">confirmed</div></button>
  <button type="button" class="tile" data-goto="unknowns"><div class="n">{{len .Unknowns}}</div><div class="l">undetermined</div></button>
</div>

<h2 id="interface">What it looks like</h2>
{{if .UITouched}}
<div class="banner">This change touches the interface and no routes were captured. Nobody has seen what it looks like — that is a gap in this review, not a clean result.</div>
{{else}}
<p class="empty">No routes were captured. No changed file is classified as interface, so there was probably nothing to see — but this is an absence of looking, not a finding that the interface is unchanged.</p>
{{end}}


<h2 id="coverage">Coverage</h2>
{{with .Coverage.Diff}}
{{if .Stale}}<div class="banner">The profile <code>{{.Profile}}</code> is older than a file in this change, so this number does not describe the code under review. Re-run the suite with <code>-coverprofile</code>.</div>{{end}}
{{if lt .Percent 0.0}}
<p class="empty">No added line in this change is coverable, so there is nothing for a test to execute. Read from <code>{{.Profile}}</code>.</p>
{{else}}
<p><b>{{printf "%.0f" .Percent}}%</b> of the {{.Lines}} coverable line{{if ne .Lines 1}}s{{end}} this change adds are executed by a test, according to <code>{{.Profile}}</code>. {{.Covered}} covered, {{sub .Lines .Covered}} not.</p>
{{end}}
{{if ge .TotalPercent 0.0}}
<p>Repository-wide, <b>{{printf "%.0f" .TotalPercent}}%</b> of {{.TotalLines}} coverable line{{if ne .TotalLines 1}}s{{end}} in <code>{{.Profile}}</code> are covered ({{.TotalCovered}} covered, {{sub .TotalLines .TotalCovered}} not) — the profile's whole scope, not just what this change added.</p>
{{end}}
{{if .Uncovered}}
<details>
  <summary>{{len .Uncovered}} file{{if ne (len .Uncovered) 1}}s{{end}} with added lines no test executes</summary>
  <div class="body"><ul class="plain">
  {{range .Uncovered}}<li><code>{{.Path}}</code> — {{len .Lines}} line{{if ne (len .Lines) 1}}s{{end}}: {{range $i, $l := .Lines}}{{if $i}}, {{end}}{{$l}}{{end}}</li>{{end}}
  </ul></div>
</details>
{{end}}
{{else}}
<p class="empty">No coverage profile was found, so whether these changes are tested is unknown. That is not the same as untested — run the suite with <code>-coverprofile=coverage.out</code> to get the number.</p>
{{end}}

{{if .Groups}}
<h2 id="drill">Drill in</h2>
{{range .Groups}}
<details>
  <summary>{{.Label}}<span class="s">{{.Count}} file{{if ne .Count 1}}s{{end}} · <span class="plus">+{{.Added}}</span> <span class="minus">−{{.Removed}}</span></span></summary>
  <div class="body">
    <div class="walk">
    {{range .Files}}
    <button type="button" class="walk-row jump" data-jump="{{.Path}}">
      <div class="walk-head">
        <code class="p">{{.Path}}</code>
        <span class="s">{{if .Findings}}<span class="tag {{.Severity}}">{{.Findings}} finding{{if ne .Findings 1}}s{{end}}</span> {{end}}{{.Status}} · <span class="plus">+{{.Added}}</span> <span class="minus">−{{.Removed}}</span></span>
      </div>
    </button>
    {{end}}
    </div>
  </div>
</details>
{{end}}
{{end}}

{{define "finding"}}
<div class="f {{lower .Severity}}" data-file="{{.File}}" data-line="{{.Line}}" data-rule="{{.Rule}}" data-sev="{{.Severity}}">
  <h3>{{.Message}}</h3>
  <div>
    <span class="tag">{{.Severity}}</span>
    <span class="tag">{{.Rule}}</span>
    <span class="tag det">observed</span>
  </div>
  {{with .Verdict}}
  <div class="verdict"><span class="tag vd">{{.Ruling}}</span><span class="s">agent{{if .Rationale}} — {{.Rationale}}{{end}}</span></div>
  {{end}}
  <div class="meta-row">
    {{if .File}}<b>{{.File}}</b>{{if .Line}}:{{.Line}}{{end}}{{else if .Anchor}}<b>{{.Anchor.Kind}} {{.Anchor.ID}}</b>{{end}}
    {{if .Expected}}<br>expected: {{.Expected}}{{end}}
    {{if .Observed}}<br>observed: {{.Observed}}{{end}}
    {{if .FixCmd}}<br>fix: {{.FixCmd}}{{end}}
  </div>
  {{if .Evidence}}<pre class="diff">{{.Evidence}}</pre>{{end}}
  {{if .Context}}<blockquote>{{.Context}}</blockquote>{{end}}
  <div class="f-actions">
    {{if .File}}<button type="button" class="f-view" data-file="{{.File}}" data-line="{{.Line}}" title="Open this file's diff at the finding">View code</button>{{end}}
    <button type="button" class="f-copy" title="Copy this finding for the agent">Copy</button>
    <button type="button" class="f-comment" title="Comment on this finding for the agent">Comment</button>
  </div>
</div>
{{end}}

{{if .Renders}}
<h2 id="changed">What changed</h2>
{{range .Renders}}
<div class="hl">
  <div class="t">{{.Title}}</div>
  <div class="d">{{.Summary}}</div>
  {{if .Lines}}<pre>{{range .Lines}}{{.}}
{{end}}</pre>{{end}}
</div>
{{end}}
{{end}}

<h2 id="observed">What Redline observed</h2>
{{if .Observed}}
{{range .Observed}}{{template "finding" .}}{{end}}
{{else}}
<p class="empty">{{if eq .Coverage.ExaminedFiles 0}}Nothing — because no pane examined this change. See the note above.{{else}}Nothing. The panes that ran found no defects.{{end}}</p>
{{end}}


<h2 id="unknowns">What could not be determined</h2>
{{if or .Unknowns .Dark}}
{{range .Dark}}<div class="hl breaking"><div class="t">{{.Name}} did not run</div><div class="d">{{.Detail}}</div></div>{{end}}
<ul class="plain">
{{range .Unknowns}}<li><b>{{.Substrate}}</b> — {{.Message}}{{if .Reason}} <span class="s">({{.Reason}})</span>{{end}}</li>{{end}}
</ul>
{{else if .Coverage.Unexamined}}
<p>Every pane that applies ran, but {{len .Coverage.Unexamined}} changed file{{if ne (len .Coverage.Unexamined) 1}}s{{end}} were not in any pane's scope.</p>
{{else}}
<p>Nothing. Every check that applies to these {{.Coverage.ExaminedFiles}} file(s) ran and answered.</p>
{{end}}
{{if .Coverage.Unexamined}}
<details>
  <summary>{{len .Coverage.Unexamined}} changed file{{if ne (len .Coverage.Unexamined) 1}}s{{end}} no pane examined</summary>
  <div class="body"><ul class="plain">{{range .Coverage.Unexamined}}<li><code>{{.}}</code></li>{{end}}</ul></div>
</details>
{{end}}
{{if .Coverage.Generated}}
<details>
  <summary>{{len .Coverage.Generated}} generated file{{if ne (len .Coverage.Generated) 1}}s{{end}} excluded from this review</summary>
  <div class="body"><ul class="plain">{{range .Coverage.Generated}}<li><code>{{.}}</code></li>{{end}}</ul></div>
</details>
{{end}}
{{if .Skipped}}
<details>
  <summary>{{len .Skipped}} pane{{if ne (len .Skipped) 1}}s{{end}} did not apply</summary>
  <div class="body"><ul class="plain">{{range .Skipped}}<li><code>{{.Name}}</code> — {{.Detail}}</li>{{end}}</ul></div>
</details>
{{end}}

<h2 id="confirms">What was checked and held</h2>
{{if .Confirms}}
<details>
  <summary>{{len .Confirms}} confirmation{{if ne (len .Confirms) 1}}s{{end}}</summary>
  <div class="body"><ul class="plain">{{range .Confirms}}<li><b>{{.Rule}}</b> — {{.Message}}</li>{{end}}</ul></div>
</details>
{{else}}
<p class="empty">Nothing was confirmed — no check reached a clean answer on this change.</p>
{{end}}

<div class="bar">
  <span class="n" id="cmt-count">No comments yet — click a diff line, or a finding's Comment, to leave one.</span>
  <span>
    <button id="copy-cmts">Copy comments for the agent</button>
    <button id="clear-cmts">Clear</button>
  </span>
</div>

</div>
</div>
{{if .DiffFiles}}
<div id="filestore" hidden>
{{range .DiffFiles}}
<div class="file" data-path="{{.Path}}">
  <div class="p">{{.Path}}</div>
  <div class="s">{{.Status}} · <span class="plus">+{{.Added}}</span> <span class="minus">−{{.Removed}}</span>
    <label class="vw"><input type="checkbox" class="viewedbox"> viewed</label>
  </div>
  {{if .Diff}}<pre class="diff">{{.Diff}}</pre>{{end}}
</div>
{{end}}
</div>
{{end}}
<div id="scrim" class="scrim" hidden></div>
<aside id="drawer" class="drawer" hidden aria-label="File detail" role="dialog" aria-modal="false">
  <header class="drawer-head">
    <code class="p" id="drawer-title"></code>
    <button type="button" id="drawer-close" class="keep">Keep briefing</button>
  </header>
  <div id="drawer-findings"></div>
  <div id="drawer-body"></div>
</aside>

<script>
// Review state lives in this browser, keyed by the report's own identity
// (base SHA + head), not by location.pathname — every run overwrites the
// same report.html, and comments from the last review must not leak into
// the next. Redline never writes this: findings.json is regenerated every
// run and fully deterministic.
(function () {
  var KEY = "redline:" + (document.body.dataset.review || location.pathname);
  var state = load();

  function load() {
    try { return JSON.parse(localStorage.getItem(KEY)) || {comments: [], viewed: {}}; }
    catch (e) { return {comments: [], viewed: {}}; }
  }
  function save() {
    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}
    render();
  }
  function render() {
    var n = state.comments.length;
    document.getElementById("cmt-count").textContent =
      n ? n + " comment" + (n === 1 ? "" : "s") + " — hand them to the agent when you are done."
        : "No comments yet — click a diff line, or a finding's Comment, to leave one.";
  }
  function copyText(text) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      return navigator.clipboard.writeText(text).catch(fallback);
    }
    return fallback();
    function fallback() {
      var ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.left = "-9999px";
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand("copy"); } catch (e) {}
      ta.remove();
      return Promise.resolve();
    }
  }

  // Restore viewed state.
  document.querySelectorAll(".file").forEach(function (f) {
    var box = f.querySelector(".viewedbox");
    if (!box) return;
    if (state.viewed[f.dataset.path]) { box.checked = true; f.classList.add("viewed"); }
    box.addEventListener("change", function () {
      f.classList.toggle("viewed", box.checked);
      state.viewed[f.dataset.path] = box.checked;
      save();
    });
  });

  function bubble(c) {
    var el = document.createElement("div");
    el.className = "cmt";
    var b = document.createElement("button");
    b.textContent = "×";
    b.title = "delete";
    b.addEventListener("click", function () {
      state.comments = state.comments.filter(function (x) { return x !== c; });
      el.remove();
      save();
    });
    var w = document.createElement("div");
    w.className = "w";
    w.textContent = c.on === "finding"
      ? (c.file || "(no file)") + (c.line ? " line " + c.line : "") + (c.rule ? " · " + c.rule : "")
      : c.file + " line " + c.line;
    var t = document.createElement("div");
    t.textContent = c.text;
    el.appendChild(b); el.appendChild(w); el.appendChild(t);
    return el;
  }

  function lineSelector(c) {
    var sel = 'span[data-file="' + CSS.escape(c.file) + '"][data-line="' + c.line + '"]';
    if (c.side) sel += '[data-side="' + CSS.escape(c.side) + '"]';
    return sel;
  }

  function findingCard(c) {
    var cards = document.querySelectorAll(".f");
    for (var i = 0; i < cards.length; i++) {
      var el = cards[i];
      if ((el.dataset.file || "") === (c.file || "") &&
          (+el.dataset.line || 0) === (c.line || 0) &&
          (el.dataset.rule || "") === (c.rule || "")) return el;
    }
    return null;
  }

  // Restore existing comments: finding comments onto their cards, line
  // comments under their diff line.
  state.comments.forEach(function (c) {
    if (c.on === "finding") {
      var card = findingCard(c);
      if (card) card.appendChild(bubble(c));
      return;
    }
    var line = document.querySelector(lineSelector(c));
    if (line) line.after(bubble(c));
  });

  document.querySelectorAll("pre.diff").forEach(function (pre) {
    pre.addEventListener("click", function (e) {
      var line = e.target.closest("span[data-line]");
      if (!line || pre.querySelector("textarea.new")) return;
      var ta = document.createElement("textarea");
      ta.className = "new";
      ta.rows = 3;
      ta.placeholder = "Comment on this line — ⌘/Ctrl+Enter to save, Esc to cancel";
      line.after(ta);
      ta.focus();
      ta.addEventListener("keydown", function (ev) {
        if (ev.key === "Escape") { ta.remove(); return; }
        if (ev.key === "Enter" && (ev.metaKey || ev.ctrlKey)) {
          var text = ta.value.trim();
          ta.remove();
          if (!text) return;
          var c = {file: line.dataset.file, line: +line.dataset.line,
                   side: line.dataset.side || "new",
                   code: line.textContent, text: text};
          state.comments.push(c);
          line.after(bubble(c));
          save();
        }
      });
    });
  });

  // Findings: copy one for the agent, or comment on it. Finding comments join
  // the same set the bottom bar hands over, so the agent gets line comments
  // and finding comments in one payload.
  document.querySelectorAll(".f").forEach(function (card) {
    var meta = {file: card.dataset.file || "", line: +card.dataset.line || 0,
                rule: card.dataset.rule || "", sev: card.dataset.sev || ""};
    var msg = (card.querySelector("h3") || {}).textContent || "";
    function snippetText() {
      var rows = card.querySelectorAll("pre.src .src-line");
      if (!rows.length) return "";
      return Array.prototype.map.call(rows, function (row) {
        var g = row.querySelector(".ln");
        var num = g ? g.textContent : "";
        var src = g ? row.textContent.slice(num.length) : row.textContent;
        return (num ? num + "  " : "") + src;
      }).join("\n");
    }
    function reference() {
      var loc = meta.file ? meta.file + (meta.line ? ":" + meta.line : "") : "";
      var out = [];
      var head = [meta.sev, meta.rule].filter(Boolean).join(" ");
      if (head) out.push(head);
      if (loc) out.push(loc);
      if (msg) out.push(msg);
      var code = snippetText();
      if (code) out.push("", code);
      return out.join("\n");
    }
    var copyBtn = card.querySelector(".f-copy");
    if (copyBtn) copyBtn.addEventListener("click", function () {
      copyText(reference()).then(function () {
        copyBtn.textContent = "Copied";
        setTimeout(function () { copyBtn.textContent = "Copy"; }, 1500);
      });
    });
    var commentBtn = card.querySelector(".f-comment");
    if (commentBtn) commentBtn.addEventListener("click", function () {
      if (card.querySelector("textarea.new")) return;
      var ta = document.createElement("textarea");
      ta.className = "new";
      ta.rows = 3;
      ta.placeholder = "Comment on this finding — ⌘/Ctrl+Enter to save, Esc to cancel";
      card.querySelector(".f-actions").after(ta);
      ta.focus();
      ta.addEventListener("keydown", function (ev) {
        if (ev.key === "Escape") { ta.remove(); return; }
        if (ev.key === "Enter" && (ev.metaKey || ev.ctrlKey)) {
          var text = ta.value.trim();
          ta.remove();
          if (!text) return;
          var c = {on: "finding", file: meta.file, line: meta.line, rule: meta.rule,
                   message: msg, code: snippetText(), text: text};
          state.comments.push(c);
          card.appendChild(bubble(c));
          save();
        }
      });
    });
  });

  // 002-B drill-in. The file node is MOVED into the drawer rather than cloned:
// its diff carries per-line comment listeners bound at load, and a clone would
// look identical while silently dropping the one affordance that matters.
(function () {
  var drawer = document.getElementById("drawer");
  var scrim = document.getElementById("scrim");
  var title = document.getElementById("drawer-title");
  var body = document.getElementById("drawer-body");
  var fbox = document.getElementById("drawer-findings");
  var slot = null, moved = null, opener = null;

  function close() {
    if (moved && slot && slot.parentNode) { slot.parentNode.replaceChild(moved, slot); }
    moved = null; slot = null;
    fbox.textContent = "";
    drawer.hidden = true; scrim.hidden = true;
    document.body.classList.remove("drawer-open");
    if (opener) { opener.focus(); opener = null; }
  }

  function open(path, from, line) {
    var target = null;
    document.querySelectorAll(".file").forEach(function (f) {
      if (!target && f.getAttribute("data-path") === path) { target = f; }
    });
    if (!target) { return; }
    close();
    opener = from || null;
    slot = document.createComment("drawer-slot");
    target.parentNode.insertBefore(slot, target);
    moved = target;
    body.appendChild(target);
    title.textContent = path;

    // A file's findings belong with its diff. These are copies: findings carry
    // no listeners, and leaving the originals in place keeps the findings list
    // whole while the drawer is open.
    document.querySelectorAll('.f[data-file]').forEach(function (f) {
      if (f.getAttribute("data-file") !== path) { return; }
      fbox.appendChild(f.cloneNode(true));
      // Mark every finding's line in the diff, so opening a file shows where its
      // findings sit — not only the one line a View code click scrolled to.
      var fl = f.getAttribute("data-line");
      if (fl && fl !== "0") {
        var s = body.querySelector('[data-line="' + fl + '"][data-side="new"]');
        if (s) { s.classList.add("hit"); }
      }
    });

    drawer.hidden = false; scrim.hidden = false;
    document.body.classList.add("drawer-open");
    drawer.scrollTop = 0;
    if (line) {
      var hit = body.querySelector('[data-line="' + line + '"][data-side="new"]') ||
                body.querySelector('[data-line="' + line + '"]');
      if (hit) { hit.classList.add("hit"); hit.scrollIntoView({ block: "center" }); }
    }
    document.getElementById("drawer-close").focus();
  }

  document.querySelectorAll(".walk-row.jump").forEach(function (row) {
    row.addEventListener("click", function () { open(row.getAttribute("data-jump"), row); });
  });
  document.querySelectorAll(".f-view").forEach(function (b) {
    b.addEventListener("click", function () {
      open(b.getAttribute("data-file"), b, parseInt(b.getAttribute("data-line"), 10) || 0);
    });
  });
  document.getElementById("drawer-close").addEventListener("click", close);
  scrim.addEventListener("click", close);
  document.addEventListener("keydown", function (e) {
    // Esc inside a comment box cancels the comment; only an Esc outside one
    // closes the drawer.
    if (e.key === "Escape" && !drawer.hidden && e.target.tagName !== "TEXTAREA") { close(); }
  });

  // The count tiles were numbers that looked like buttons and did nothing.
  // Each now goes to the section it counts; errors and warnings also narrow
  // the findings list to what was clicked.
  var note = null;
  function clearFilter() {
    document.querySelectorAll(".f[data-file]").forEach(function (f) { f.hidden = false; });
    if (note) { note.remove(); note = null; }
  }
  // Sidebar: mark the section you are reading. The nav itself is rendered
  // server-side, so this only adds the highlight — losing it costs nothing.
  (function () {
    var links = {};
    document.querySelectorAll(".nav a[data-nav]").forEach(function (a) {
      links[a.getAttribute("data-nav")] = a;
    });
    var heads = Object.keys(links)
      .map(function (id) { return document.getElementById(id); })
      .filter(Boolean)
      .sort(function (a, b) { return a.offsetTop - b.offsetTop; });
    if (!heads.length) { return; }

    function mark(id) {
      for (var key in links) { links[key].classList.toggle("on", key === id); }
    }
    // Whichever heading is highest above the reading line is the section you
    // are in. Tracked on scroll rather than by heading visibility, because a
    // long section leaves no heading on screen at all and the sidebar would
    // then mark nothing.
    var line = 120;
    var current = "";
    function update() {
      var found = heads[0].id;
      for (var i = 0; i < heads.length; i++) {
        if (heads[i].getBoundingClientRect().top <= line) { found = heads[i].id; }
      }
      if (found !== current) { current = found; mark(found); }
    }
    var queued = false;
    window.addEventListener("scroll", function () {
      if (queued) { return; }
      queued = true;
      requestAnimationFrame(function () { queued = false; update(); });
    }, {passive: true});
    update();
  })();

  document.querySelectorAll(".tile[data-goto]").forEach(function (tile) {
    tile.addEventListener("click", function () {
      var head = document.getElementById(tile.getAttribute("data-goto"));
      var only = tile.getAttribute("data-only");
      clearFilter();
      if (only) {
        var shown = 0;
        document.querySelectorAll(".f[data-file]").forEach(function (f) {
          var match = f.classList.contains(only);
          f.hidden = !match;
          if (match) { shown++; }
        });
        note = document.createElement("p");
        note.className = "filter-note";
        note.textContent = "Showing " + shown + " " + only + (shown === 1 ? "" : "s") + " only. ";
        var all = document.createElement("button");
        all.type = "button";
        all.textContent = "Show all findings";
        all.addEventListener("click", clearFilter);
        note.appendChild(all);
        if (head) { head.insertAdjacentElement("afterend", note); }
      }
      if (head) { head.scrollIntoView({ behavior: "smooth", block: "start" }); }
    });
  });
})();

document.getElementById("copy-cmts").addEventListener("click", function () {
    // The payload names the change it belongs to. A bare list of file:line
    // comments pasted into a session that has since moved on would be applied
    // to the wrong tree, and the agent cannot tell without being told.
    var payload = JSON.stringify({redlineReviewComments: {
      instruction: "A human reviewed this change and left the comments below, each on a specific diff line or a specific finding. " +
        "Address every one: make the change, or reply saying why you did not. " +
        "Do not re-review the rest of the diff. When you are done, re-run redline so the report reflects the new state.",
      review: document.body.dataset.review || "",
      target: document.body.dataset.target || "",
      comments: state.comments
    }}, null, 2);
    copyText(payload).then(function () {
      var b = document.getElementById("copy-cmts");
      b.textContent = "Copied — paste into your agent session";
      setTimeout(function () { b.textContent = "Copy comments for the agent"; }, 2500);
    });
  });
  document.getElementById("clear-cmts").addEventListener("click", function () {
    if (!confirm("Delete all comments and viewed marks for this report?")) return;
    state = {comments: [], viewed: {}};
    document.querySelectorAll(".cmt").forEach(function (e) { e.remove(); });
    document.querySelectorAll(".viewedbox").forEach(function (b) {
      b.checked = false; b.closest(".file").classList.remove("viewed");
    });
    save();
  });

  render();
})();
</script>
</body>
</html>
