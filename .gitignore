/.redline/
/redline
/redline-graphify-context
/redline-scout
# The Graphify index the context provider reads. It is a build artifact that
# drifts with whatever last ran `graphify update`, which is why the harness
# profile treats it like a coverage profile rather than a source file.
/graphify-out/
# goreleaser build output (make snapshot / make release).
/dist/
# Redline reads a coverage profile to compute diff coverage. It is a local
# artifact, and one that got committed once already.
/coverage.out
/cover.out
# gomutants writes its report and incremental cache here; both are local.
/mutants.json
/.gomutants-cache.json
.compound-engineering/*.local.yaml

/.planning/
scratch/
# Personal agent config stays local. The session hook and the settings that
# register it are the repository's: a hook only reaches a session when it is
# on the branch, and this one installs the pinned linter into a fresh
# container.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
/bin/
